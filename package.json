{
  "name": "mo",
  "version": "1.0.0",
  "private": true,
  "description": "墨水纯前端本地优先互动叙事编辑器",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "python -X utf8 start_index.py",
    "dev": "vite",
    "build": "npm run build:player && vite build",
    "build:app": "vite build",
    "build:player": "vite build --config vite.player.config.ts && node scripts/install-player-template.mjs",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:e2e": "npm run build && playwright test tests/e2e --project=chromium --max-failures=1",
    "test:stress": "npm run build:app && playwright test tests/stress/editor.stress.spec.ts --project=chromium --max-failures=1 --retries=0",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "verify": "npm run type-check && npm run test:unit && npm run build && npm run check:boundaries",
    "verify:full": "npm run verify && playwright test tests/e2e tests/stress --project=chromium --max-failures=1 --retries=0"
  },
  "dependencies": {
    "blockly": "^13.2.0",
    "idb": "^8.0.3",
    "jszip": "^3.10.1",
    "marked": "^11.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-draggable": "^4.4.6",
    "react-router-dom": "^7.18.2",
    "reactflow": "^11.10.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.2.56",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/ui": "^4.1.10",
    "fake-indexeddb": "^6.2.4",
    "jsdom": "^28.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.10"
  }
}
